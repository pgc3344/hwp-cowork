# ── 기본 ────────────────────────────────────────────────
# 바깥에서 보이는 주소 (링크·OAuth 에 쓴다). 리버스 프록시 뒤라면 그 HTTPS 주소
HWPCOWORK_PUBLIC_BASE=http://localhost:8119
# 포트를 열 주소. 0.0.0.0 이면 모든 망에서 — 이때는 인증을 꼭 켠다
HWPCOWORK_BIND=127.0.0.1
# 리버스 프록시 뒤라면 그 호스트를 넣는다 (DNS rebinding 방어). 비우면 검사하지 않는다
HWPCOWORK_ALLOWED_HOSTS=
HWPCOWORK_ALLOWED_ORIGINS=

# ── 인증: none | token | oidc ───────────────────────────
#   none   인증 없음 (로컬·사내망·인증 프록시 뒤)
#   token  Bearer 토큰 하나 (32자 이상). 클라이언트 헤더에 Authorization: Bearer <토큰>
#   oidc   OIDC (Authentik·Keycloak·Zitadel …) + 사람별 권한 파일 — claude.ai 커넥터의 OAuth 로그인
HWPCOWORK_AUTH=none
# token 모드:  openssl rand -hex 32
HWPCOWORK_TOKEN=
# token 모드, 여러 사람:  [{"token": "...", "label": "Alice", "roots": "all", "write": true}]
HWPCOWORK_TOKENS_FILE=
# oidc 모드: public(PKCE) 클라이언트, redirect URI 에 <PUBLIC_BASE>/sso/callback
HWPCOWORK_OIDC_ISSUER=
HWPCOWORK_OIDC_CLIENT_ID=
HWPCOWORK_RESOURCE_URL=
HWPCOWORK_PRINCIPALS_FILE=

# ── 그 밖 ───────────────────────────────────────────────
# 사본을 원본 폴더에 직접 써도 되는 루트 (쉼표). 비우면 읽기 전용 — 내려받기로만 반출
HWPCOWORK_WRITABLE_ROOTS=
# 첨부 올리기 링크 주소 — 비우면 PUBLIC_BASE
HWPCOWORK_UPLOAD_BASE=
# 손대지 않은 작업 사본 보관 일수
HWPCOWORK_KEEP_DAYS=30
# /internal/health 보호 키 (비우면 키 없이)
HWPCOWORK_HEALTH_KEY=
